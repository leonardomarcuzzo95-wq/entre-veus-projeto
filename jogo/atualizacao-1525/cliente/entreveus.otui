Panel
  id: entreveusHeader
  anchors.top: parent.top
  anchors.left: parent.left
  anchors.right: parent.right
  height: 84
  margin: 8
  background-color: #11282ef2
  border-width: 1
  border-color: #62877f
  phantom: true

  Label
    id: title
    text: ENTRE VEUS  /  PORTO DA MEMORIA
    color: #edcf91
    font: verdana-11px-rounded
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 12
    margin-right: 12
    margin-top: 8
    height: 14
    text-wrap: true

  Label
    id: objective
    color: #e1f1eb
    anchors.left: prev.left
    anchors.right: prev.right
    anchors.top: prev.bottom
    margin-top: 6
    height: 28
    text-wrap: true

  Label
    id: controls
    text: Setas: andar | Chat: digite e aperte Enter | Comandos: oi e missao (sem acento)
    color: #b8d7d0
    anchors.left: prev.left
    anchors.right: prev.right
    anchors.top: prev.bottom
    margin-top: 6
    height: 14
    text-wrap: true
